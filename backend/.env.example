# ──────────────────────────────────────────────────────────────────────────────
# SIH Backend – Environment Variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>

# JWT configuration
JWT_SECRET=change_me_to_a_strong_random_string
JWT_EXPIRES_IN=7d

# Google OAuth Web Client ID
GOOGLE_WEB_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Meon Aadhaar KYC API credentials
MEON_SECRET_TOKEN=your_meon_secret_token
MEON_COMPANY_CODE=your_company_code
MEON_COMPANY_NAME=your_company_name
MEON_BASE_URL=https://api.meon.co.in

# Server
PORT=3000
NODE_ENV=production

# Workers must verify Aadhaar before going online (true/false, default false)
REQUIRE_WORKER_AADHAAR=false

# Razorpay — payments for completed jobs (test keys: rzp_test_…)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Platform's cut of online payments, in percent
PLATFORM_FEE_PERCENT=0
# 'simulated' records worker payouts without moving money (prototype);
# 'route' transfers through Razorpay Route linked accounts
PAYOUT_MODE=simulated
# Payouts wait this long after a worker changes their bank details
PAYOUT_CHANGE_HOLD_HOURS=24
# Public base URL of this API (for receipt links), e.g. https://api.example.com/api
PUBLIC_API_URL=

# Heatmaps — grid cells with fewer items than this are hidden (privacy)
HEATMAP_MIN_COUNT=2
# Centre for `npm run seed:heatmap` demo data (lat,lng); optional
HEATMAP_DEMO_CENTER=
