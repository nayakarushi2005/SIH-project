MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>

JWT_SECRET=change_me_to_a_strong_random_string
JWT_EXPIRES_IN=7d

GOOGLE_WEB_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

MEON_SECRET_TOKEN=your_meon_secret_token
MEON_COMPANY_CODE=your_company_code
MEON_COMPANY_NAME=your_company_name
MEON_BASE_URL=https://api.meon.co.in

PORT=3000
NODE_ENV=production
