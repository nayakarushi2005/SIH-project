{
  "expo": {
    "name": "Sahayak",
    "slug": "sih-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sihproject.connect"
    },
    "android": {
      "package": "com.sihproject.connect",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.YOUR_IOS_CLIENT_ID_HERE"
        }
      ],
      "expo-web-browser",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/CenturyGothic-Bold.ttf"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#097d4c",
          "image": "./assets/splash-icon.png",
          "imageWidth": 188
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to attach photos of the work to your job.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to take photos of the work for your job."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sahayak uses your location to show jobs and workers near you."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Sahayak uses the microphone so you can answer questions by speaking.",
          "speechRecognitionPermission": "Sahayak converts your speech to text to fill in your registration.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "scheme": "sihconnect",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5a71188d-d500-45ce-944d-a0dcabd344c6"
      }
    }
  }
}
