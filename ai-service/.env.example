NODE_API_URL=http://localhost:3000/api
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>
# GOOGLE_CLOUD_PROJECT is optional when GOOGLE_APPLICATION_CREDENTIALS points at
# a service-account key file that already has a project_id field.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=./keys/vertex-service-account.json
GEMINI_MODEL=gemini-3.8-flash
LOG_LEVEL=INFO
