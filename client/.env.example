# Copy to .env. Vite only exposes variables starting with VITE_ to the browser,
# so never put secrets here — they end up in the built JavaScript.

# Backend base URL (defaults to http://localhost:8080)
# VITE_API_URL=http://localhost:3000

# Google OAuth client ID for sign-in
# VITE_GOOGLE_CLIENT_ID=

# Reverse geocoder for "Use my location" (Nominatim-compatible, no key needed)
VITE_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
